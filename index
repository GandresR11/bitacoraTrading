    <script>
        // --- ESTADO Y PERSISTENCIA ---
        const STORAGE_KEY = 'fx_journal_trades_v1';
        let trades = [];
        let currentFilter = 'ALL';

        // Inicialización al cargar el DOM
        window.onload = function() {
            lucide.createIcons();
            setDefaultDateTime();
            loadTrades();
            renderTrades();
            renderStats();
        };

        // Fecha y hora local actual para el formulario
        function setDefaultDateTime() {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('tradeDateTime').value = now.toISOString().slice(0, 16);
        }

        // --- GESTIÓN DE TEMA DÍA / NOCHE ---
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
        }

        // --- NAVEGACIÓN Y PESTAÑAS ---
        function switchTab(tabName) {
            ['registro', 'bitacora', 'stats'].forEach(t => {
                const section = document.getElementById(`tab-${t}`);
                const deskBtn = document.getElementById(`desk-tab-${t}`);
                const mobBtn = document.getElementById(`mob-tab-${t}`);

                if (t === tabName) {
                    section.classList.remove('hidden');
                    if (deskBtn) deskBtn.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2 text-white bg-green-600 shadow-sm";
                    if (mobBtn) mobBtn.className = "flex flex-col items-center justify-center w-full py-1 text-green-600 dark:text-green-400 font-semibold";
                } else {
                    section.classList.add('hidden');
                    if (deskBtn) deskBtn.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white";
                    if (mobBtn) mobBtn.className = "flex flex-col items-center justify-center w-full py-1 text-gray-500 dark:text-gray-400";
                }
            });

            if (tabName === 'stats') {
                renderStats();
            } else if (tabName === 'bitacora') {
                renderTrades();
            }
        }

        // --- AGREGAR PARES CUSTOM ---
        function addNewPair() {
            const newPair = prompt("Ingresa el nuevo Par de Divisas (ej: NZDUSD o NAS100):");
            if (newPair && newPair.trim() !== '') {
                const cleanPair = newPair.trim().toUpperCase();
                const select = document.getElementById('pairSelect');
                const option = document.createElement('option');
                option.value = cleanPair;
                option.textContent = cleanPair;
                select.appendChild(option);
                select.value = cleanPair;
            }
        }

        // --- MOSTRAR / OCULTAR CAMPO 'OTRO' DE CONFIRMACIÓN ---
        function toggleCustomConfirmation() {
            const select = document.getElementById('confirmationType');
            const container = document.getElementById('customConfirmationContainer');
            if (select.value === 'Otro') {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        // --- CÓDIGO DE TRADES / LOCALSTORAGE ---
        function loadTrades() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    trades = JSON.parse(saved);
                } catch(e) {
                    trades = [];
                }
            }
        }

        function saveTrades() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(trades));
        }

        // --- MÓDULO 1: GUARDAR TRADE ---
        function handleSaveTrade(e) {
            e.preventDefault();

            const confSelect = document.getElementById('confirmationType').value;
            const customConf = document.getElementById('customConfirmation').value;
            const finalConfirmation = confSelect === 'Otro' ? (customConf || 'Otro') : confSelect;

            const newTrade = {
                id: 'trade_' + Date.now(),
                pair: document.getElementById('pairSelect').value,
                direction: document.querySelector('input[name="direction"]:checked').value,
                dateTime: document.getElementById('tradeDateTime').value,
                impulseTF: document.getElementById('impulseTF').value,
                zoneType: document.getElementById('zoneType').value,
                confirmationTF: document.getElementById('confirmationTF').value,
                confirmationType: finalConfirmation,
                isReentry: document.getElementById('checkReentry').checked,
                respectedNews: document.getElementById('checkNews').checked,
                followedPlan: document.getElementById('checkPlan').checked,
                mentalCalm: document.getElementById('checkCalm').checked,
                emotionalNotes: document.getElementById('emotionalNotes').value,
                // Datos de cierre (inicialmente pendiente)
                status: 'PENDING', // PENDING o CLOSED
                outcome: null, // TP, SL, BE, MANUAL
                rr: null,
                pips: null,
                slMoved: false,
                postNotes: ''
            };

            trades.unshift(newTrade);
            saveTrades();

            // Reset Formulario
            document.getElementById('tradeForm').reset();
            document.getElementById('customConfirmationContainer').classList.add('hidden');
            setDefaultDateTime();

            // Notificación visual rápida
            alert('¡Operación registrada con éxito en la Bitácora!');
            switchTab('bitacora');
        }

        // --- MÓDULO 2: FILTROS Y RENDER DE BITÁCORA ---
        function setFilter(filter) {
            currentFilter = filter;
            ['ALL', 'PENDING', 'CLOSED'].forEach(f => {
                const btn = document.getElementById(`filter-${f}`);
                if (f === filter) {
                    btn.className = "touch-target px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm";
                } else {
                    btn.className = "touch-target px-3 py-1.5 text-xs font-semibold rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white";
                }
            });
            renderTrades();
        }

        function renderTrades() {
            const container = document.getElementById('tradesList');
            container.innerHTML = '';

            let filteredTrades = trades;
            if (currentFilter === 'PENDING') filteredTrades = trades.filter(t => t.status === 'PENDING');
            if (currentFilter === 'CLOSED') filteredTrades = trades.filter(t => t.status === 'CLOSED');

            if (filteredTrades.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full py-12 text-center bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl">
                        <i data-lucide="inbox" class="w-10 h-10 mx-auto text-gray-400 mb-2"></i>
                        <p class="text-sm text-gray-500 dark:text-gray-400">No hay operaciones registradas en esta vista.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            filteredTrades.forEach(trade => {
                const card = document.createElement('div');
                card.className = "bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm flex flex-col justify-between space-y-3";

                // Badges y Estado
                let outcomeBadge = '<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-yellow-500/10 text-yellow-600 dark:text-yellow-400">PENDIENTE</span>';
                if (trade.status === 'CLOSED') {
                    if (trade.outcome === 'TP') outcomeBadge = `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-green-500/10 text-green-600 dark:text-green-400">TP (+${trade.rr}R)</span>`;
                    else if (trade.outcome === 'SL') outcomeBadge = `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-red-500/10 text-red-600 dark:text-red-400">SL (${trade.rr}R)</span>`;
                    else if (trade.outcome === 'BE') outcomeBadge = `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-gray-500/10 text-gray-400">BE (0.0R)</span>`;
                    else outcomeBadge = `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-yellow-500/10 text-yellow-600">MANUAL (${trade.rr}R)</span>`;
                }

                const isBuy = trade.direction === 'BUY';
                const dirColor = isBuy ? 'text-green-600 dark:text-green-400 bg-green-500/10' : 'text-red-600 dark:text-red-400 bg-red-500/10';

                card.innerHTML = `
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-base font-extrabold">${trade.pair}</span>
                                <span class="px-2 py-0.5 text-xs font-bold rounded-md ${dirColor}">${trade.direction}</span>
                            </div>
                            ${outcomeBadge}
                        </div>

                        <div class="text-xs text-gray-500 dark:text-gray-400 flex flex-wrap gap-x-3 gap-y-1">
                            <span><strong class="text-gray-700 dark:text-gray-300">Fecha:</strong> ${trade.dateTime.replace('T', ' ')}</span>
                            <span><strong class="text-gray-700 dark:text-gray-300">Impulso:</strong> ${trade.impulseTF}</span>
                            <span><strong class="text-gray-700 dark:text-gray-300">Zona:</strong> ${trade.zoneType}</span>
                        </div>

                        <div class="text-xs text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-800/60 p-2.5 rounded-xl space-y-1 border border-gray-100 dark:border-gray-800">
                            <p><strong>Confirmación:</strong> ${trade.confirmationTF} - ${trade.confirmationType}</p>
                            ${trade.isReentry ? '<p class="text-yellow-600 dark:text-yellow-400 font-semibold">• Es una Reentrada</p>' : ''}
                            ${trade.emotionalNotes ? `<p class="italic text-gray-500 dark:text-gray-400">"${trade.emotionalNotes}"</p>` : ''}
                        </div>

                        ${trade.status === 'CLOSED' ? `
                            <div class="text-xs pt-1 border-t border-gray-100 dark:border-gray-800 space-y-1">
                                ${trade.slMoved ? '<p class="text-yellow-600 dark:text-yellow-400 font-medium">⚠️ SL fue modificado durante la orden</p>' : ''}
                                ${trade.postNotes ? `<p class="text-gray-600 dark:text-gray-300"><strong>Lección:</strong> ${trade.postNotes}</p>` : ''}
                            </div>
                        ` : ''}
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100 dark:border-gray-800">
                        <button onclick="openResultModal('${trade.id}')" class="touch-target px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white rounded-xl text-xs font-bold flex items-center gap-1 shadow-sm">
                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> ${trade.status === 'CLOSED' ? 'Editar Resultado' : 'Cargar Resultado'}
                        </button>
                        <button onclick="deleteTrade('${trade.id}')" class="touch-target p-2 text-gray-400 hover:text-red-500 rounded-xl" title="Eliminar">
                            <i data-lucide="trash" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;

                container.appendChild(card);
            });

            lucide.createIcons();
        }

        // Modal Cargar Resultado
        function openResultModal(tradeId) {
            const trade = trades.find(t => t.id === tradeId);
            if (!trade) return;

            document.getElementById('modalTradeId').value = trade.id;
            document.getElementById('resultRR').value = trade.rr !== null ? trade.rr : '';
            document.getElementById('resultPips').value = trade.pips !== null ? trade.pips : '';
            document.getElementById('slMovedToggle').checked = trade.slMoved || false;
            document.getElementById('postNotes').value = trade.postNotes || '';

            if (trade.outcome) {
                const radio = document.querySelector(`input[name="outcome"][value="${trade.outcome}"]`);
                if (radio) radio.checked = true;
            }

            document.getElementById('closeTradeModal').classList.remove('hidden');
        }

        function closeResultModal() {
            document.getElementById('closeTradeModal').classList.add('hidden');
        }

        function handleSaveResult(e) {
            e.preventDefault();
            const id = document.getElementById('modalTradeId').value;
            const trade = trades.find(t => t.id === id);

            if (trade) {
                trade.status = 'CLOSED';
                trade.outcome = document.querySelector('input[name="outcome"]:checked').value;
                trade.rr = parseFloat(document.getElementById('resultRR').value) || 0;
                trade.pips = parseFloat(document.getElementById('resultPips').value) || 0;
                trade.slMoved = document.getElementById('slMovedToggle').checked;
                trade.postNotes = document.getElementById('postNotes').value;

                saveTrades();
                closeResultModal();
                renderTrades();
            }
        }

        function deleteTrade(id) {
            if (confirm('¿Estás seguro de que deseas eliminar este registro?')) {
                trades = trades.filter(t => t.id !== id);
                saveTrades();
                renderTrades();
            }
        }

        // --- MÓDULO 3: DASHBOARD DE ESTADÍSTICAS ---
        function renderStats() {
            const closedTrades = trades.filter(t => t.status === 'CLOSED');
            const totalClosed = closedTrades.length;

            // 1. Win Rate
            const wins = closedTrades.filter(t => t.outcome === 'TP').length;
            const winRate = totalClosed > 0 ? ((wins / totalClosed) * 100).toFixed(1) : '0';
            document.getElementById('stat-winrate').textContent = `${winRate}%`;
            document.getElementById('stat-winrate-sub').textContent = `${wins} TP / ${totalClosed} Cerrados`;

            // 2. R:R Total
            const totalRR = closedTrades.reduce((acc, t) => acc + (t.rr || 0), 0).toFixed(1);
            document.getElementById('stat-rr-total').textContent = `${totalRR > 0 ? '+' : ''}${totalRR} R`;
            document.getElementById('stat-rr-total').className = `text-2xl md:text-3xl font-extrabold mt-1 ${totalRR >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`;

            // 3. Par Más Rentable & 4. Par Más Operado
            const pairMap = {};
            closedTrades.forEach(t => {
                if (!pairMap[t.pair]) pairMap[t.pair] = { count: 0, rr: 0 };
                pairMap[t.pair].count += 1;
                pairMap[t.pair].rr += (t.rr || 0);
            });

            let bestPair = '-';
            let bestRR = -999;
            let frequentPair = '-';
            let maxCount = 0;

            Object.keys(pairMap).forEach(pair => {
                if (pairMap[pair].rr > bestRR) {
                    bestRR = pairMap[pair].rr;
                    bestPair = pair;
                }
                if (pairMap[pair].count > maxCount) {
                    maxCount = pairMap[pair].count;
                    frequentPair = pair;
                }
            });

            document.getElementById('stat-best-pair').textContent = bestPair;
            document.getElementById('stat-best-pair-sub').textContent = bestRR !== -999 ? `${bestRR.toFixed(1)} R acumulados` : '0.0 R';
            document.getElementById('stat-frequent-pair').textContent = frequentPair;
            document.getElementById('stat-frequent-pair-sub').textContent = `${maxCount} ejecuciones`;

            // 5. Distribución TP/SL/BE/Manual
            const tpCount = closedTrades.filter(t => t.outcome === 'TP').length;
            const slCount = closedTrades.filter(t => t.outcome === 'SL').length;
            const beCount = closedTrades.filter(t => t.outcome === 'BE').length;
            const manualCount = closedTrades.filter(t => t.outcome === 'MANUAL').length;

            const distContainer = document.getElementById('stat-distribution-bars');
            distContainer.innerHTML = `
                ${renderProgressBar('Take Profit (TP)', tpCount, totalClosed, 'bg-green-500')}
                ${renderProgressBar('Stop Loss (SL)', slCount, totalClosed, 'bg-red-500')}
                ${renderProgressBar('Break Even (BE)', beCount, totalClosed, 'bg-gray-400')}
                ${renderProgressBar('Cierre Manual', manualCount, totalClosed, 'bg-yellow-500')}
            `;

            // 6. Disciplina SL Movido
            const slMovedCount = closedTrades.filter(t => t.slMoved).length;
            const slMovedPct = totalClosed > 0 ? ((slMovedCount / totalClosed) * 100).toFixed(0) : 0;
            document.getElementById('stat-sl-moved-count').textContent = `${slMovedCount} Trades (${slMovedPct}%)`;
            
            const slBadge = document.getElementById('stat-sl-badge');
            if (slMovedCount === 0) {
                slBadge.textContent = "100% Disciplinado";
                slBadge.className = "px-2.5 py-1 text-xs font-bold rounded-lg bg-green-500/10 text-green-600 dark:text-green-400";
            } else {
                slBadge.textContent = "⚠️ Alerta de Disciplina";
                slBadge.className = "px-2.5 py-1 text-xs font-bold rounded-lg bg-yellow-500/10 text-yellow-600 dark:text-yellow-400";
            }

            // 7. Efectividad por Temporalidad (1H vs 15M Bias)
            const h1Trades = closedTrades.filter(t => t.impulseTF === '1H');
            const m15Trades = closedTrades.filter(t => t.impulseTF === '15M');
            const h1Wins = h1Trades.filter(t => t.outcome === 'TP').length;
            const m15Wins = m15Trades.filter(t => t.outcome === 'TP').length;

            document.getElementById('stat-tf-breakdown').innerHTML = `
                <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-bold text-gray-500">Impulso 1H</p>
                    <p class="text-lg font-extrabold mt-1">${h1Trades.length > 0 ? ((h1Wins/h1Trades.length)*100).toFixed(0) : 0}% Win Rate</p>
                    <p class="text-[11px] text-gray-400">${h1Wins}/${h1Trades.length} ganados</p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-bold text-gray-500">Impulso 15M</p>
                    <p class="text-lg font-extrabold mt-1">${m15Trades.length > 0 ? ((m15Wins/m15Trades.length)*100).toFixed(0) : 0}% Win Rate</p>
                    <p class="text-[11px] text-gray-400">${m15Wins}/${m15Trades.length} ganados</p>
                </div>
            `;

            // 8. Rendimiento por Tipo de Zona
            const zones = ['IFVG', 'FVG', 'OB', 'General'];
            const zoneContainer = document.getElementById('stat-zone-breakdown');
            zoneContainer.innerHTML = '';
            zones.forEach(z => {
                const zTrades = closedTrades.filter(t => t.zoneType === z);
                const zRR = zTrades.reduce((acc, t) => acc + (t.rr || 0), 0).toFixed(1);
                zoneContainer.innerHTML += `
                    <div class="flex items-center justify-between text-xs p-2 bg-gray-50 dark:bg-gray-800 rounded-xl">
                        <span class="font-semibold">${z} (${zTrades.length} trades)</span>
                        <span class="font-extrabold ${zRR >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-500'}">${zRR > 0 ? '+' : ''}${zRR} R</span>
                    </div>
                `;
            });

            // 9. Reentradas vs Primeras Entradas
            const reentries = closedTrades.filter(t => t.isReentry);
            const firstEntries = closedTrades.filter(t => !t.isReentry);
            const reWin = reentries.filter(t => t.outcome === 'TP').length;
            const firstWin = firstEntries.filter(t => t.outcome === 'TP').length;

            document.getElementById('stat-reentry-breakdown').innerHTML = `
                <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-bold text-gray-500">1ª Entrada</p>
                    <p class="text-lg font-extrabold mt-1">${firstEntries.length > 0 ? ((firstWin/firstEntries.length)*100).toFixed(0) : 0}% Win Rate</p>
                    <p class="text-[11px] text-gray-400">${firstWin}/${firstEntries.length} ganados</p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-bold text-gray-500">Reentradas</p>
                    <p class="text-lg font-extrabold mt-1">${reentries.length > 0 ? ((reWin/reentries.length)*100).toFixed(0) : 0}% Win Rate</p>
                    <p class="text-[11px] text-gray-400">${reWin}/${reentries.length} ganados</p>
                </div>
            `;

            // 10. Rachas Máximas
            let maxWinStreak = 0, currentWins = 0;
            let maxLossStreak = 0, currentLosses = 0;

            closedTrades.slice().reverse().forEach(t => {
                if (t.outcome === 'TP') {
                    currentWins++;
                    currentLosses = 0;
                    if (currentWins > maxWinStreak) maxWinStreak = currentWins;
                } else if (t.outcome === 'SL') {
                    currentLosses++;
                    currentWins = 0;
                    if (currentLosses > maxLossStreak) maxLossStreak = currentLosses;
                } else {
                    currentWins = 0;
                    currentLosses = 0;
                }
            });

            document.getElementById('stat-max-win-streak').textContent = `${maxWinStreak} Seguidos`;
            document.getElementById('stat-max-loss-streak').textContent = `${maxLossStreak} Seguidos`;

            // Listado de Notas Emocionales
            const notesContainer = document.getElementById('stat-emotional-log');
            notesContainer.innerHTML = '';
            const tradesWithNotes = trades.filter(t => t.emotionalNotes || t.postNotes);

            if (tradesWithNotes.length === 0) {
                notesContainer.innerHTML = '<p class="text-xs text-gray-400">Sin notas registradas todavía.</p>';
            } else {
                tradesWithNotes.slice(0, 8).forEach(t => {
                    notesContainer.innerHTML += `
                        <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 text-xs space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-green-600 dark:text-green-400">${t.pair} (${t.direction})</span>
                                <span class="text-gray-400 text-[10px]">${t.dateTime.replace('T', ' ')}</span>
                            </div>
                            ${t.emotionalNotes ? `<p><strong class="text-gray-500">Pre-Trade:</strong> ${t.emotionalNotes}</p>` : ''}
                            ${t.postNotes ? `<p><strong class="text-gray-500">Post-Trade:</strong> ${t.postNotes}</p>` : ''}
                        </div>
                    `;
                });
            }
        }

        function renderProgressBar(label, count, total, colorClass) {
            const pct = total > 0 ? ((count / total) * 100).toFixed(0) : 0;
            return `
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 dark:text-gray-400">${label} (${count})</span>
                        <span class="font-bold">${pct}%</span>
                    </div>
                    <div class="w-full h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
                        <div class="h-full ${colorClass}" style="width: ${pct}%"></div>
                    </div>
                </div>
            `;
        }

        // --- HERRAMIENTAS Y HERRAMIENTAS DE DATOS ---
        function openSettingsModal() {
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

