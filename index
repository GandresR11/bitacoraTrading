<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Forex Trading Journal & Analytics</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d'
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Touch target adjustments & mobile scroll smoothing */
        body {
            -webkit-tap-highlight-color: transparent;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        .touch-target {
            min-height: 44px;
        }
        /* Custom scrollbar for desktop */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.4);
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col pb-20 md:pb-6">

    <!-- TOP HEADER -->
    <header class="sticky top-0 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 px-4 py-3">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="p-2 bg-green-500/10 text-green-500 rounded-xl">
                    <i data-lucide="candlestick-chart" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-base md:text-lg font-bold leading-tight">FX Journal Pro</h1>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Bitácora & Psicología</p>
                </div>
            </div>

            <!-- DESKTOP TABS & THEME / SETTINGS -->
            <div class="flex items-center gap-2">
                <nav class="hidden md:flex items-center bg-gray-100 dark:bg-gray-800 p-1 rounded-xl mr-2">
                    <button onclick="switchTab('registro')" id="desk-tab-registro" class="px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2 text-white bg-green-600 shadow-sm">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Registrar
                    </button>
                    <button onclick="switchTab('bitacora')" id="desk-tab-bitacora" class="px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
                        <i data-lucide="list" class="w-4 h-4"></i> Bitácora
                    </button>
                    <button onclick="switchTab('stats')" id="desk-tab-stats" class="px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
                        <i data-lucide="bar-chart-3" class="w-4 h-4"></i> Estadísticas
                    </button>
                </nav>

                <button onclick="toggleTheme()" class="touch-target p-2.5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" title="Cambiar Tema">
                    <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    <i data-lucide="moon" class="w-5 h-5 block dark:hidden"></i>
                </button>

                <button onclick="openSettingsModal()" class="touch-target p-2.5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" title="Ajustes y Datos">
                    <i data-lucide="settings" class="w-5 h-5"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6">
        
        <!-- PESTAÑA 1: REGISTRAR OPERACIÓN -->
        <section id="tab-registro" class="space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold">Nueva Operación</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Registra el contexto operativo y tu estado emocional antes de entrar.</p>
                </div>
            </div>

            <form id="tradeForm" onsubmit="handleSaveTrade(event)" class="space-y-6">
                <!-- Información Básica -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 md:p-6 space-y-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-green-600 dark:text-green-400 uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="sliders" class="w-4 h-4"></i> Configuración Inicial
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Par de divisas -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Par de Divisas</label>
                            <div class="flex gap-2">
                                <select id="pairSelect" required class="flex-1 touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                                    <option value="EURUSD">EUR/USD</option>
                                    <option value="GBPUSD">GBP/USD</option>
                                    <option value="USDJPY">USD/JPY</option>
                                    <option value="XAUUSD">XAU/USD (Oro)</option>
                                    <option value="AUDUSD">AUD/USD</option>
                                    <option value="USDCAD">USD/CAD</option>
                                </select>
                                <button type="button" onclick="addNewPair()" class="touch-target px-3 bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 rounded-xl flex items-center justify-center" title="Agregar Par Custom">
                                    <i data-lucide="plus" class="w-5 h-5"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Dirección (Compra / Venta) -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Dirección</label>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="touch-target flex items-center justify-center gap-2 p-2 border border-gray-300 dark:border-gray-700 rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 has-[:checked]:bg-green-500/10 has-[:checked]:border-green-500 has-[:checked]:text-green-600">
                                    <input type="radio" name="direction" value="BUY" checked class="hidden">
                                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                                    <span class="text-sm font-semibold">BUY</span>
                                </label>
                                <label class="touch-target flex items-center justify-center gap-2 p-2 border border-gray-300 dark:border-gray-700 rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 has-[:checked]:bg-red-500/10 has-[:checked]:border-red-500 has-[:checked]:text-red-600">
                                    <input type="radio" name="direction" value="SELL" class="hidden">
                                    <i data-lucide="trending-down" class="w-4 h-4"></i>
                                    <span class="text-sm font-semibold">SELL</span>
                                </label>
                            </div>
                        </div>

                        <!-- Fecha y Hora -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Fecha y Hora Local</label>
                            <input type="datetime-local" id="tradeDateTime" required class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                        </div>

                        <!-- Temporalidad Impulso -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Temporalidad Impulso / Bias</label>
                            <select id="impulseTF" class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                                <option value="1H">1H (1 Hora)</option>
                                <option value="15M">15M (15 Minutos)</option>
                                <option value="4H">4H (4 Horas)</option>
                                <option value="1D">1D (Diario)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Análisis Técnico y Zona -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 md:p-6 space-y-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-green-600 dark:text-green-400 uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4"></i> Contexto & Confirmación
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Tipo de Zona -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Tipo de Zona</label>
                            <select id="zoneType" class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                                <option value="IFVG">IFVG (Inverted FVG)</option>
                                <option value="FVG">FVG (Fair Value Gap)</option>
                                <option value="OB">OB (Order Block)</option>
                                <option value="General">General / Soporte-Resistencia</option>
                            </select>
                        </div>

                        <!-- Temporalidad Confirmación -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Temporalidad Confirmación</label>
                            <select id="confirmationTF" class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                                <option value="5M">5M</option>
                                <option value="1M">1M</option>
                                <option value="15M">15M</option>
                                <option value="Directa">Directa (Sin confirmación menor)</option>
                            </select>
                        </div>

                        <!-- Tipo de Confirmación -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Gatillo de Confirmación</label>
                            <select id="confirmationType" onchange="toggleCustomConfirmation()" class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                                <option value="CHoCH / MSS">CHoCH / MSS (Market Structure Shift)</option>
                                <option value="Liquidity Sweep">Barrido de Liquidez (Sweep)</option>
                                <option value="Breaker Block">Breaker Block</option>
                                <option value="Vwap Bounce">Rebote VWAP / EMAs</option>
                                <option value="Otro">Otro (Especificar)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Campo dinámico para 'Otro' -->
                    <div id="customConfirmationContainer" class="hidden">
                        <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5">Especificar Confirmación</label>
                        <input type="text" id="customConfirmation" placeholder="Ej: Envolvente en VWAP + SMT" class="w-full touch-target bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none">
                    </div>

                    <!-- Checkboxes Psicotrading / Checklist -->
                    <div class="pt-2">
                        <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-2">Checklist Pre-Operación & Contexto</label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <label class="touch-target flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 cursor-pointer">
                                <input type="checkbox" id="checkReentry" class="w-5 h-5 rounded text-green-600 focus:ring-green-500 border-gray-300 dark:border-gray-700">
                                <span class="text-sm font-medium">¿Es una Reentrada?</span>
                            </label>

                            <label class="touch-target flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 cursor-pointer">
                                <input type="checkbox" id="checkNews" class="w-5 h-5 rounded text-green-600 focus:ring-green-500 border-gray-300 dark:border-gray-700">
                                <span class="text-sm font-medium">Respetó Noticias / Macro</span>
                            </label>

                            <label class="touch-target flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 cursor-pointer">
                                <input type="checkbox" id="checkPlan" class="w-5 h-5 rounded text-green-600 focus:ring-green-500 border-gray-300 dark:border-gray-700" checked>
                                <span class="text-sm font-medium">100% Alineado con el Trading Plan</span>
                            </label>

                            <label class="touch-target flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 cursor-pointer">
                                <input type="checkbox" id="checkCalm" class="w-5 h-5 rounded text-green-600 focus:ring-green-500 border-gray-300 dark:border-gray-700" checked>
                                <span class="text-sm font-medium">Estado Mental Sereno (Sin FOMO/Venganza)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Bitácora Emocional -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 md:p-6 space-y-3 shadow-sm">
                    <h3 class="text-sm font-semibold text-green-600 dark:text-green-400 uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="brain" class="w-4 h-4"></i> Psicología Pre-Operación
                    </h3>
                    <textarea id="emotionalNotes" rows="3" placeholder="¿Qué sientes antes de ejecutar? (Ej: Confiado por alineación con DXY, ligero temor por la noticia de las 10:00...)" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl p-3 text-sm focus:ring-2 focus:ring-green-500 focus:outline-none"></textarea>
                </div>

                <!-- Botón de Guardado -->
                <button type="submit" class="w-full touch-target py-3.5 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white font-bold rounded-xl shadow-lg shadow-green-600/20 transition-all flex items-center justify-center gap-2 text-base">
                    <i data-lucide="save" class="w-5 h-5"></i> Guardar Operación en Bitácora
                </button>
            </form>
        </section>

        <!-- PESTAÑA 2: BITÁCORA Y CARGA DE RESULTADOS -->
        <section id="tab-bitacora" class="space-y-6 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold">Bitácora de Trades</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Revisa tus entradas y carga los resultados finales.</p>
                </div>

                <!-- Filtros Rápidos -->
                <div class="flex items-center gap-1.5 bg-gray-200 dark:bg-gray-800 p-1 rounded-xl self-start sm:self-auto">
                    <button onclick="setFilter('ALL')" id="filter-ALL" class="touch-target px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm">
                        Todas
                    </button>
                    <button onclick="setFilter('PENDING')" id="filter-PENDING" class="touch-target px-3 py-1.5 text-xs font-semibold rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                        Pendientes
                    </button>
                    <button onclick="setFilter('CLOSED')" id="filter-CLOSED" class="touch-target px-3 py-1.5 text-xs font-semibold rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                        Cerradas
                    </button>
                </div>
            </div>

            <!-- Trade Cards Grid -->
            <div id="tradesList" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Se llena dinámicamente con JS -->
            </div>
        </section>

        <!-- PESTAÑA 3: DASHBOARD DE ESTADÍSTICAS (10 MÉTRICAS) -->
        <section id="tab-stats" class="space-y-6 hidden">
            <div>
                <h2 class="text-xl font-bold">Dashboard de Rendimiento</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400">Análisis detallado de tus 10 métricas clave de trading.</p>
            </div>

            <!-- METRICAS KPI GRID -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                <!-- Métrica 1: Win Rate -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">1. Win Rate Effective</p>
                    <h3 id="stat-winrate" class="text-2xl md:text-3xl font-extrabold text-green-600 dark:text-green-400 mt-1">0%</h3>
                    <p id="stat-winrate-sub" class="text-xs text-gray-400 mt-1">0 TP / 0 Trades</p>
                </div>

                <!-- Métrica 2: Profit Factor / R:R Neto -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">2. R:R Total Acumulado</p>
                    <h3 id="stat-rr-total" class="text-2xl md:text-3xl font-extrabold mt-1">0.0 R</h3>
                    <p class="text-xs text-gray-400 mt-1">Rendimiento global</p>
                </div>

                <!-- Métrica 3: Par más rentable -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">3. Par Más Rentable</p>
                    <h3 id="stat-best-pair" class="text-xl md:text-2xl font-bold mt-1 text-gray-800 dark:text-gray-200">-</h3>
                    <p id="stat-best-pair-sub" class="text-xs text-gray-400 mt-1">0.0 R generados</p>
                </div>

                <!-- Métrica 4: Par más frecuente -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">4. Par Más Operado</p>
                    <h3 id="stat-frequent-pair" class="text-xl md:text-2xl font-bold mt-1 text-gray-800 dark:text-gray-200">-</h3>
                    <p id="stat-frequent-pair-sub" class="text-xs text-gray-400 mt-1">0 ejecuciones</p>
                </div>
            </div>

            <!-- DETALLES DE ANÁLISIS EN CUADRÍCULA -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Métrica 5: Distribución TP/SL/BE/Manual -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>5. Distribución de Cierres</span>
                        <i data-lucide="pie-chart" class="w-4 h-4 text-gray-400"></i>
                    </h3>
                    <div id="stat-distribution-bars" class="space-y-2">
                        <!-- Bars filled by JS -->
                    </div>
                </div>

                <!-- Métrica 6: Disciplina SL Movido (Alerta) -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>6. Disciplina de Stop Loss</span>
                        <i data-lucide="shield-alert" class="w-4 h-4 text-yellow-500"></i>
                    </h3>
                    <div id="stat-sl-moved-container" class="p-4 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                        <p class="text-xs text-gray-500 dark:text-gray-400">¿Se ha movido el SL fuera de plan?</p>
                        <div class="flex items-center justify-between mt-2">
                            <span id="stat-sl-moved-count" class="text-lg font-bold text-gray-800 dark:text-gray-200">0 Trades (0%)</span>
                            <span id="stat-sl-badge" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-green-500/10 text-green-600 dark:text-green-400">
                                100% Disciplinado
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Métrica 7: Efectividad por Impulso (1H vs 15M) -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>7. Efectividad: 1H vs 15M Bias</span>
                        <i data-lucide="clock" class="w-4 h-4 text-gray-400"></i>
                    </h3>
                    <div id="stat-tf-breakdown" class="grid grid-cols-2 gap-3">
                        <!-- Content JS -->
                    </div>
                </div>

                <!-- Métrica 8: Rendimiento por Tipo de Zona -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>8. Rendimiento por Zona (IFVG vs FVG vs OB)</span>
                        <i data-lucide="layers" class="w-4 h-4 text-gray-400"></i>
                    </h3>
                    <div id="stat-zone-breakdown" class="space-y-2">
                        <!-- Content JS -->
                    </div>
                </div>

                <!-- Métrica 9: Reentradas vs Primeras Entradas -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>9. Reentradas vs 1ª Entrada</span>
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-gray-400"></i>
                    </h3>
                    <div id="stat-reentry-breakdown" class="grid grid-cols-2 gap-3">
                        <!-- Content JS -->
                    </div>
                </div>

                <!-- Métrica 10: Rachas de Win / Loss Seguidos -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-semibold flex items-center justify-between">
                        <span>10. Rachas Consecutivas Máximas</span>
                        <i data-lucide="zap" class="w-4 h-4 text-yellow-500"></i>
                    </h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-3 bg-green-500/10 rounded-xl border border-green-500/20">
                            <p class="text-xs text-green-600 dark:text-green-400 font-semibold">Racha Max TP</p>
                            <p id="stat-max-win-streak" class="text-xl font-extrabold text-green-700 dark:text-green-300 mt-1">0 Seguidos</p>
                        </div>
